# Supabase project (Settings -> API in the Supabase dashboard).
# The publishable/anon key is safe to expose to the browser; access control
# is enforced by row-level security.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# The Gemini API key is server-side only and does NOT go in this file:
#   hosted:  npx supabase secrets set GOOGLE_AI_API_KEY=...
#   local:   put it in supabase/functions/.env (see supabase/functions/.env.example)

# Optional: set both to show a "Try the demo account" button on the login page.
# Create the account in Supabase Auth first.
# VITE_DEMO_EMAIL="demo@example.com"
# VITE_DEMO_PASSWORD="..."
