# Supabase project (Settings -> API in the Supabase dashboard).
# The publishable/anon key is safe to expose to the browser; access control
# is enforced by row-level security.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Server-side secrets (NOT in this file) — set them as Supabase edge function
# secrets instead: supabase secrets set GEMINI_API_KEY=...
